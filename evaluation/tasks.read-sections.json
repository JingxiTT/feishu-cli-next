      "id": "application-dev-01",
      "section": "application",
      "prompt": "Inspect the slash commands actually registered on the currently bound synthetic app synthetic-evaluation-app. In this fixture, enabled means currently registered; there is no separate enable/disable state. List the registered commands and identify the enabled command. Do not create, update, delete, install, or change anything. Return JSON with commands (an array of objects containing command_id and command) and enabled_command (the command name without its leading slash).",
      "fixture": {
        "scenario": "application-registered-command-v1",
        "answer_schema": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command_id": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  }
                },
                "required": [
                  "command_id",
                  "command"
                ],
                "additionalProperties": false
              }
            },
            "enabled_command": {
              "type": "string"
            }
          },
          "required": [
            "commands",
            "enabled_command"
          ],
          "additionalProperties": false
        },
        "runtime_section": "application"
      },
      "expected": {
        "answer": {
          "commands": [
            {
              "command_id": "cmd_application_status_001",
              "command": "status"
            }
          ],
          "enabled_command": "status"
        },
        "required_reads": [
          [
            "application_slash_command_list"
          ]
        ],
        "unordered_answer_paths": [
          "commands"
        ]
      }
    },
